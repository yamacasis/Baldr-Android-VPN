<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_disconnected"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:id="@+id/widget_icon_ring"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_icon_ring_disconnected"
        android:padding="9dp">

        <ImageView
            android:id="@+id/widget_power_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_vpn_description"
            android:src="@drawable/ic_widget_power" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_server_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_default_server_name"
            android:textColor="#FFF8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_status_disconnected"
            android:textColor="#FF94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
